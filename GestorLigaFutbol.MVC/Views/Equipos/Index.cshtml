@model IEnumerable<GestorLigaFutbol.Models.Equipo>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ciudad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AnioFundacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LigaId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.liga)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Jugadores)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosLocal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosVisitante)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Ciudad)
            </td>
            <td>
                @Html.DisplayFor(model => item.AnioFundacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.LigaId)
            </td>
            <td>
                @Html.DisplayFor(model => item.liga)
            </td>
            <td>
                @Html.DisplayFor(model => item.Jugadores)
            </td>
            <td>
                @Html.DisplayFor(model => item.PartidosLocal)
            </td>
            <td>
                @Html.DisplayFor(model => item.PartidosVisitante)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
